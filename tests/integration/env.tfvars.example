# Copy to env.tfvars and fill in your test environment values.
# env.tfvars is gitignored - environment-specific IDs never enter the repo.
#
# Use DEDICATED test accounts: the fixture enables GCP APIs, creates IAM
# roles/service accounts in both clouds, and tears everything down after.

project_id     = "your-gcp-test-project-id"
region         = "us-central1"
aws_account_id = "123456789012"
aws_region     = "us-east-1"
aws_profile    = "your-aws-test-profile"
